<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.report_design</groupId>
    <artifactId>report-design-backend-rest</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <report-design.version>0.1.2</report-design.version>
    </properties>

    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/report-builder-app/report-design-lib</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Библиотека отчётов -->
        <dependency>
            <groupId>com.report_design</groupId>
            <artifactId>report-design-core</artifactId>
            <version>${report-design.version}</version>
        </dependency>
        <dependency>
            <groupId>com.report_design</groupId>
            <artifactId>report-design-renderer-pdf</artifactId>
            <version>${report-design.version}</version>
        </dependency>
        <dependency>
            <groupId>com.report_design</groupId>
            <artifactId>report-design-renderer-xls</artifactId>
            <version>${report-design.version}</version>
        </dependency>
        <dependency>
            <groupId>com.report_design</groupId>
            <artifactId>report-design-renderer-html</artifactId>
            <version>${report-design.version}</version>
        </dependency>
        <dependency>
            <groupId>com.report_design</groupId>
            <artifactId>report-design-renderer-json</artifactId>
            <version>${report-design.version}</version>
        </dependency>

        <!-- Spring Boot 4 Web MVC (в 4.x стартер называется webmvc) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Валидация -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Тесты -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>